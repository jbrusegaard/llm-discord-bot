# Discord bot token (Developer Portal → Applications → Bot → Reset Token)
DISCORD_TOKEN=your-discord-bot-token

# LM Studio server (OpenAI-compatible). Start LM Studio, load a model,
# and enable the local server (default port 1234).
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=
LMSTUDIO_MODEL=local-model

# Optional
# SYSTEM_PROMPT=You are a helpful assistant on a Discord server.
# MAX_HISTORY=20
# HISTORY_DB=data/history.db   # where per-conversation chat history is persisted
# COMPACT_AT=40                # summarize old messages once a user has more than this stored
